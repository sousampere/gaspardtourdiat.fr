# ---------------------------------------------------------------------------
# GaspardTourdiat.fr — environment configuration
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# --- HTTP -------------------------------------------------------------------
# Host port the nginx container is published on.
HTTP_PORT=8080

# --- DNS --------------------------------------------------------------------
# Only needed on restricted networks (school/corporate) where the LAN DNS is
# unreachable from inside Docker. Harmless elsewhere.
DNS_PRIMARY=1.1.1.1
DNS_SECONDARY=8.8.8.8

# --- MariaDB ----------------------------------------------------------------
DB_NAME=gaspardtourdiat
DB_USER=gtd
DB_PASSWORD=change-me-db-password
# Only used to initialise the database volume on first boot.
DB_ROOT_PASSWORD=change-me-root-password

# --- API --------------------------------------------------------------------
PORT=3000
NODE_ENV=production
# Must be a long random string. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-please-generate-a-long-random-secret

# --- Admin panel (/?  ->  /admin) -------------------------------------------
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-admin-password

# --- GitHub -----------------------------------------------------------------
GITHUB_USERNAME=sousampere
# Optional but strongly recommended: without it GitHub's API is rate limited to
# 60 requests/hour and the commit statistics cannot be computed.
# Create one at https://github.com/settings/tokens (no scopes needed for public data).
GITHUB_TOKEN=

# How long cached GitHub data stays fresh before the API re-syncs.
SYNC_INTERVAL_HOURS=6
